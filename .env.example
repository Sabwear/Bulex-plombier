# ============================================================================
# ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control!
# Install Next SEO: npm install next-seo
# ============================================================================

# ----------------------------------------------------------------------------
# BRAND & SITE CONFIGURATION
# ----------------------------------------------------------------------------

# Site Name/Brand (appears everywhere: title, footer, emails, etc.)
NEXT_PUBLIC_SITE_NAME="Villant Loodgieter"

# Short Name (used in manifest, app shortcuts)
NEXT_PUBLIC_SITE_SHORT_NAME="Villant Loodgieter"

# Site URL (production domain, no trailing slash)
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# Site Tagline/Slogan
NEXT_PUBLIC_SITE_TAGLINE=""

# Site Description (used for meta tags, 150–160 chars)
NEXT_PUBLIC_SITE_DESCRIPTION="Villant Loodgieter – Vaillant loodgieter Brussel. Fill with your actual site description (150–160 chars)."

# Site Keywords (comma-separated, from brain: primary + secondary)
NEXT_PUBLIC_SITE_KEYWORDS="Vaillant loodgieter Brussel,Vaillant herstelling Brussel,boiler vervangen Brussel,nieuwe verwarming plaatsen Brussel,loodgieter spoeddienst Brussel,gecertificeerd Vaillant partner België,onderhoudscontract Vaillant,waterlek herstellen Brussel,sanitair installatie Brussel,duurzame verwarming oplossingen,verwarmingsmonteur Brussel"

# ----------------------------------------------------------------------------
# CONTACT INFORMATION
# ----------------------------------------------------------------------------

# Primary Support Email
NEXT_PUBLIC_SUPPORT_EMAIL="contact@villant-loodgieter.be"

# Admin/Business Email
ADMIN_EMAIL="contact@villant-loodgieter.be"

# WhatsApp Number (without + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER="1234567890"

# Telegram Username (without @)
NEXT_PUBLIC_TELEGRAM_USERNAME=""

# Phone Number for Display
NEXT_PUBLIC_PHONE_DISPLAY="Contact phone to be added"

# Company Address (optional)
NEXT_PUBLIC_COMPANY_ADDRESS="Your business address"

# ----------------------------------------------------------------------------
# SOCIAL MEDIA
# ----------------------------------------------------------------------------

NEXT_PUBLIC_TWITTER_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_YOUTUBE_URL=""
NEXT_PUBLIC_TIKTOK_URL=""
NEXT_PUBLIC_LINKEDIN_URL=""

# ----------------------------------------------------------------------------
# BRANDING & THEME
# ----------------------------------------------------------------------------

NEXT_PUBLIC_BRAND_COLOR="#2563eb"
NEXT_PUBLIC_GRADIENT_FROM="#2563eb"
NEXT_PUBLIC_GRADIENT_TO="#3b82f6"
NEXT_PUBLIC_BG_COLOR="#0f0f0f"
NEXT_PUBLIC_LOGO_PATH="/images/logo.png"
NEXT_PUBLIC_LOGO_ICON="/images/logo-icon.png"

# ----------------------------------------------------------------------------
# SEO & ANALYTICS
# ----------------------------------------------------------------------------

NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_FB_PIXEL_ID=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# ----------------------------------------------------------------------------
# LOCALE & LANGUAGE
# ----------------------------------------------------------------------------

NEXT_PUBLIC_LOCALE="en"
NEXT_PUBLIC_COUNTRY="Brussels, Belgium"
NEXT_PUBLIC_CURRENCY="USD"
NEXT_PUBLIC_CURRENCY_SYMBOL="$"

# ----------------------------------------------------------------------------
# DEVELOPMENT
# ----------------------------------------------------------------------------

NODE_ENV="development"
DEBUG="false"

# ----------------------------------------------------------------------------
# NOTES
# ----------------------------------------------------------------------------
# 1. NEXT_PUBLIC_ prefix = accessible in browser
# 2. Variables without prefix = server-side only
# 3. Copy to .env.local and fill values
# 4. Restart dev server after changes
# 5. Use next-seo for meta tags & JSON-LD
# ============================================================================
