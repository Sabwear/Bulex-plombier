# ============================================================================
# ENVIRONMENT CONFIGURATION (EXAMPLE)
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# BRAND & SITE CONFIGURATION
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME="Your Site Name"
NEXT_PUBLIC_SITE_SHORT_NAME="Your Short Name"
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
NEXT_PUBLIC_SITE_TAGLINE="Your tagline"
NEXT_PUBLIC_SITE_DESCRIPTION="Your site description"
NEXT_PUBLIC_SITE_KEYWORDS="keyword1,keyword2,keyword3"

# ----------------------------------------------------------------------------
# CONTACT INFORMATION
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPPORT_EMAIL="support@your-domain.com"
ADMIN_EMAIL="admin@your-domain.com"

# ----------------------------------------------------------------------------
# SMTP (server-side forms: contact, intervention, offerte)
# ----------------------------------------------------------------------------
MAIL_FROM="noreply@your-domain.com"
MAIL_TO="admin@your-domain.com"
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="smtp-user@your-domain.com"
SMTP_PASS="your_smtp_password"

# ----------------------------------------------------------------------------
# BUSINESS CONTACT
# ----------------------------------------------------------------------------
NEXT_PUBLIC_PHONE_NUMBER="+32000000000"
NEXT_PUBLIC_TELEGRAM_USERNAME=""
NEXT_PUBLIC_COMPANY_ADDRESS="Street 1, 1000 City, Country"

# ----------------------------------------------------------------------------
# SOCIAL MEDIA
# ----------------------------------------------------------------------------
NEXT_PUBLIC_TWITTER_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_INSTAGRAM_URL=""
#NEXT_PUBLIC_YOUTUBE_URL=""
#NEXT_PUBLIC_TIKTOK_URL=""
#NEXT_PUBLIC_LINKEDIN_URL=""

# ----------------------------------------------------------------------------
# BRANDING & THEME
# ----------------------------------------------------------------------------
NEXT_PUBLIC_BRAND_COLOR="#00ADAB"
NEXT_PUBLIC_BG_COLOR="#0f0f0f"
NEXT_PUBLIC_LOGO_PATH="public/logo.png"
NEXT_PUBLIC_LOGO_ICON="public/flamme.svg"

# ----------------------------------------------------------------------------
# SEO & ANALYTICS
# ----------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_FB_PIXEL_ID=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_GOOGLE_ADS_ID=""
NEXT_PUBLIC_GOOGLE_ADS_PHONE_CONVERSION_LABEL=""
NEXT_PUBLIC_GOOGLE_ADS_PHONE_CONVERSION_NUMBER=""

# ----------------------------------------------------------------------------
# LOCALE & LANGUAGE
# ----------------------------------------------------------------------------
NEXT_PUBLIC_LOCALE="nl"
NEXT_PUBLIC_COUNTRY="Belgium"
NEXT_PUBLIC_CURRENCY="EUR"
NEXT_PUBLIC_CURRENCY_SYMBOL="€"

# ----------------------------------------------------------------------------
# DEVELOPMENT
# ----------------------------------------------------------------------------
NODE_ENV="development"
DEBUG="true"

# ----------------------------------------------------------------------------
# NOTES
# ----------------------------------------------------------------------------
# 1. NEXT_PUBLIC_ prefix = accessible in browser
# 2. Variables without prefix = server-side only
# 3. Copy to .env.local and fill values
# 4. Restart dev server after changes
# ============================================================================
